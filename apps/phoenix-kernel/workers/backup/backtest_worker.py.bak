"""Backtest Worker - Strategy Backtesting Engine"""

import asyncio
import logging
import random
import time
from datetime import datetime, timedelta
from typing import Dict, List, Any, Optional
from workers.base_worker import BaseWorker

logger = logging.getLogger(__name__)

class BacktestWorker(BaseWorker):
    """
    Backtest Worker - Simulates trading strategies on historical data
    """
    
    def __init__(self, hive_bus=None):
        super().__init__("backtest", hive_bus)
        self.results_cache = {}
        self.running_backtests = {}
        logger.info("   BacktestWorker initialized")
    
    async def health_check(self):
        """Health check for backtest worker"""
        base = await super().health_check()
        return {
            **base,
            'healthy': True,
            'worker': 'backtest',
            'cached_results': len(self.results_cache)
        }
    
    async def process(self, task: Any) -> Dict[str, Any]:
        """Process backtest tasks"""
        # Handle string commands
        if isinstance(task, str):
            if task == '/backtest results':
                return await self._get_latest_results()
            elif task.startswith('/backtest run'):
                strategy = task.replace('/backtest run', '').strip() or 'momentum'
                return await self._run_backtest(strategy)
            else:
                return {'error': f'Unknown backtest command: {task}'}
        
        # Handle dict commands
        action = task.get('action', 'status')
        if action == 'run':
            return await self._run_backtest(task.get('strategy', 'momentum'))
        elif action == 'results':
            return await self._get_results(task.get('backtest_id'))
        elif action == 'list':
            return await self._list_backtests()
        else:
            return await self._get_latest_results()
    
    async def _run_backtest(self, strategy: str) -> Dict[str, Any]:
        """Run a backtest simulation"""
        backtest_id = f"bt_{int(time.time())}"
        
        # Simulate backtest running
        logger.info(f"  Running backtest for strategy: {strategy}")
        
        # Generate mock results
        total_trades = random.randint(50, 200)
        winning_trades = random.randint(int(total_trades * 0.4), int(total_trades * 0.7))
        losing_trades = total_trades - winning_trades
        
        results = {
            'id': backtest_id,
            'strategy': strategy,
            'start_date': (datetime.now() - timedelta(days=30)).isoformat(),
            'end_date': datetime.now().isoformat(),
            'initial_capital': 1000000,
            'final_capital': 1000000 * (1 + random.uniform(-0.1, 0.3)),
            'total_trades': total_trades,
            'winning_trades': winning_trades,
            'losing_trades': losing_trades,
            'win_rate': round((winning_trades / total_trades) * 100, 2),
            'profit_loss': random.randint(-50000, 150000),
            'max_drawdown': round(random.uniform(5, 25), 2),
            'sharpe_ratio': round(random.uniform(0.5, 2.5), 2),
            'timestamp': datetime.now().isoformat()
        }
        
        # Store results
        self.results_cache[backtest_id] = results
        self.results_cache['latest'] = results
        
        # Store in memory bus
        if self.hive_bus:
            self.hive_bus.store(
                f"backtest:{backtest_id}",
                results,
                tags=['backtest', strategy, 'results']
            )
        
        return {
            'status': 'completed',
            'backtest_id': backtest_id,
            'results': results
        }
    
    async def _get_results(self, backtest_id: Optional[str] = None) -> Dict[str, Any]:
        """Get backtest results"""
        if backtest_id and backtest_id in self.results_cache:
            return {'results': self.results_cache[backtest_id]}
        elif 'latest' in self.results_cache:
            return {'results': self.results_cache['latest']}
        else:
            return {'error': 'No backtest results found'}
    
    async def _get_latest_results(self) -> Dict[str, Any]:
        """Get latest backtest results"""
        if 'latest' in self.results_cache:
            # Trigger triangulation effect
            return {
                'results': self.results_cache['latest'],
                'effect': 'triangulation',
                'message': 'Triangulation Engine Active'
            }
        else:
            # Run a default backtest
            return await self._run_backtest('momentum')
    
    async def _list_backtests(self) -> Dict[str, Any]:
        """List all cached backtests"""
        return {
            'backtests': [
                {'id': k, 'strategy': v.get('strategy'), 'timestamp': v.get('timestamp')}
                for k, v in self.results_cache.items()
                if k != 'latest'
            ][-10:]  # Last 10
        }



